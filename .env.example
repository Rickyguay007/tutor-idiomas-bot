# Copia este archivo como .env y llena tus datos. El .env NUNCA se sube a GitHub.

# Token del bot (lo da @BotFather en Telegram)
TELEGRAM_TOKEN=

# --- IA que hace de profesora (cualquier API compatible con OpenAI) ---
# DeepSeek (barato):  LLM_BASE_URL=https://api.deepseek.com                         LLM_MODEL=deepseek-chat
# Qwen / Alibaba:     LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# Gemini (gratis):    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
# Ollama local:       LLM_BASE_URL=http://localhost:11434/v1                        LLM_MODEL=qwen2.5:7b   (LLM_API_KEY=ollama)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Voz a texto (Whisper). Groq tiene plan gratuito: https://console.groq.com ---
# Déjalo vacío si no quieres notas de voz.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# --- Voces para responder (Edge TTS, gratis) ---
VOICE_ZH=zh-CN-XiaoxiaoNeural
VOICE_EN=en-US-AvaNeural
VOICE_ES=es-EC-AndreaNeural

# --- Otros ---
# IDs de Telegram que pueden usar el bot, separados por coma.
# Si lo dejas vacío, cualquiera que encuentre el bot gasta tus créditos de IA.
# Para saber tu ID, escríbele al bot: si estás bloqueado te lo dice.
ALLOWED_USERS=
TIMEZONE=America/Guayaquil
DB_PATH=data/idiomas.db
HISTORY_TURNS=8
